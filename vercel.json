{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://go.ifrc.org"
        },
        {
          "key": "X-Frame-Options",
          "value": "ALLOW-FROM https://go.ifrc.org"
        }
      ]
    }
  ]
}
